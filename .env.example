POSTGRES_DB=reglo
POSTGRES_USER=reglo
POSTGRES_PASSWORD=reglo
# Web: features still on fictitious data (web/src/lib/api/mocks.ts) instead
# of the API. Empty: the features whose endpoints do not exist yet
# ("dashboard,domains,news"); the signed-in user ("me") is real.
# Also "all", "none" or a comma-separated list. Read by the Next.js server at
# runtime (no rebuild needed).
API_MOCKS=
# Login always calls the real API (POST /api/auth/login), even with mocks.
# Create a client and its first administrator (activation e-mail in Mailpit):
# docker compose exec api php bin/console app:create-organization "<name>" <email> <first name> <last name>
