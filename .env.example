POSTGRES_DB=reglo
POSTGRES_USER=reglo
POSTGRES_PASSWORD=reglo
# Web: use fictitious data (web/src/lib/api/mocks.ts) instead of the API.
# "false" calls the real API. Read at build time (NEXT_PUBLIC_*).
NEXT_PUBLIC_USE_MOCKS=true
# Login always calls the real API (POST /api/auth/login), even with mocks.
# Create an account with: docker compose exec api php bin/console app:user:create <email>
