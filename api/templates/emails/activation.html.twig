{% extends 'emails/layout.html.twig' %}

{% block title %}Activez votre compte Réglo{% endblock %}

{% block content %}
    <p style="margin: 0 0 16px; font-size: 16px;">Bonjour{% if first_name %} {{ first_name }}{% endif %},</p>
    <p style="margin: 0 0 16px; font-size: 16px; line-height: 1.5;">
        Un compte administrateur a été créé pour vous sur Réglo{% if organization_name %} pour l'organisation <strong>{{ organization_name }}</strong>{% endif %}.
        Pour l'activer, choisissez votre mot de passe :
    </p>
    <p style="margin: 24px 0; text-align: center;">
        <a href="{{ activation_url }}" style="display: inline-block; padding: 12px 24px; background: #0f6b63; color: #ffffff; font-size: 16px; font-weight: bold; text-decoration: none; border-radius: 8px;">Activer mon compte</a>
    </p>
    <p style="margin: 0 0 16px; font-size: 14px; line-height: 1.5; color: #4b5856;">
        Ce lien est valable {{ valid_hours }} heures et ne peut être utilisé qu'une seule fois.
        S'il ne fonctionne pas, copiez cette adresse dans votre navigateur :<br>
        <a href="{{ activation_url }}" style="color: #0f6b63; word-break: break-all;">{{ activation_url }}</a>
    </p>
    <p style="margin: 0; font-size: 14px; line-height: 1.5; color: #4b5856;">
        Si vous n'attendiez pas cet e-mail, vous pouvez l'ignorer.
    </p>
{% endblock %}
