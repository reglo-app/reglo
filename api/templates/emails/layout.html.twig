<!DOCTYPE html>
<html lang="fr">
    <head>
        <meta charset="UTF-8">
        <meta name="viewport" content="width=device-width, initial-scale=1">
        <title>{% block title %}Réglo{% endblock %}</title>
    </head>
    <body style="margin: 0; padding: 24px; background: #f4f6f5; font-family: Arial, Helvetica, sans-serif; color: #1f2a28;">
        <table role="presentation" width="100%" cellpadding="0" cellspacing="0">
            <tr>
                <td align="center">
                    <table role="presentation" width="100%" cellpadding="0" cellspacing="0" style="max-width: 560px; background: #ffffff; border-radius: 12px; padding: 32px;">
                        <tr>
                            <td>
                                {# Embedded (not linked) so it shows even when remote images are blocked.
                                   Empty alt: the wordmark next to it already gives the name. #}
                                <table role="presentation" cellpadding="0" cellspacing="0" style="margin: 0 0 24px;">
                                    <tr>
                                        <td style="padding-right: 10px; vertical-align: middle;">
                                            <img src="{{ email.image('@email_images/reglo-symbol.png') }}" width="36" height="28" alt="" style="display: block; border: 0;">
                                        </td>
                                        <td style="vertical-align: middle; font-size: 22px; font-weight: bold; color: #0f6b63;">REGLO</td>
                                    </tr>
                                </table>
                                {% block content %}{% endblock %}
                            </td>
                        </tr>
                    </table>
                </td>
            </tr>
        </table>
    </body>
</html>
