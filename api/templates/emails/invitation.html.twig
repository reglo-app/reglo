{% extends 'emails/layout.html.twig' %}

{% block title %}Rejoignez {{ organization_name }} sur Réglo{% endblock %}

{% block content %}
    <p style="margin: 0 0 16px; font-size: 16px;">Bonjour{% if first_name %} {{ first_name }}{% endif %},</p>
    <p style="margin: 0 0 16px; font-size: 16px; line-height: 1.5;">
        {% if inviter_name %}{{ inviter_name }} vous invite{% else %}Vous êtes invité(e){% endif %}
        à rejoindre <strong>{{ organization_name }}</strong> sur Réglo, l'outil qui aide votre entreprise
        à suivre sa démarche QHSE : diagnostic, plan d'actions, justificatifs et formations.
    </p>
    <p style="margin: 0 0 16px; font-size: 16px; line-height: 1.5;">
        Pour accepter l'invitation, choisissez votre mot de passe :
    </p>
    <p style="margin: 24px 0; text-align: center;">
        <a href="{{ invitation_url }}" style="display: inline-block; padding: 12px 24px; background: #0f6b63; color: #ffffff; font-size: 16px; font-weight: bold; text-decoration: none; border-radius: 8px;">Accepter l'invitation</a>
    </p>
    <p style="margin: 0 0 16px; font-size: 14px; line-height: 1.5; color: #4b5856;">
        Ce lien est valable {{ valid_days }} jours et ne peut être utilisé qu'une seule fois.
        S'il ne fonctionne pas, copiez cette adresse dans votre navigateur :<br>
        <a href="{{ invitation_url }}" style="color: #0f6b63; word-break: break-all;">{{ invitation_url }}</a>
    </p>
    <p style="margin: 0; font-size: 14px; line-height: 1.5; color: #4b5856;">
        Vous ne connaissez pas cette entreprise ? Ignorez cet e-mail : aucun compte ne sera créé.
    </p>
{% endblock %}
