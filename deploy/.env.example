# Copy to /srv/reglo-<env>/.env on the server. Never commit the real file.
COMPOSE_PROJECT_NAME=reglo-preprod
ENV_NAME=preprod
GHCR_OWNER=your-github-organization
IMAGE_TAG=latest
POSTGRES_DB=reglo
POSTGRES_USER=reglo
POSTGRES_PASSWORD=change-me
APP_SECRET=change-me
# SMTP server of the e-mails sent to users (activation links), e.g.
# smtp://user:password@smtp.example.com:587. "null://null" sends nothing.
MAILER_DSN=null://null
# Sender of the e-mails; the domain must be allowed by the SMTP provider
MAILER_FROM=no-reply@reglo.site
# Public URL of the web app, used in the links of the e-mails
APP_WEB_URL=https://preprod.reglo.site
# Shared secret between the API and the data service (score of the
# diagnostic), sent in the X-Service-Token header. Required: the deployment
# stops without it. Generate one per environment: openssl rand -hex 32
DATA_SERVICE_TOKEN=change-me
# Web: features still on fictitious data. Empty: the features whose API
# endpoints do not exist yet ("dashboard,domains,news"); the signed-in user is
# real. Also "all", "none" or a comma-separated list. Read at runtime:
# "docker compose up -d" applies a change, no rebuild needed.
API_MOCKS=
