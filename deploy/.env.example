# Copy to /srv/reglo-<env>/.env on the server. Never commit the real file.
COMPOSE_PROJECT_NAME=reglo-preprod
ENV_NAME=preprod
GHCR_OWNER=your-github-organization
IMAGE_TAG=latest
POSTGRES_DB=reglo
POSTGRES_USER=reglo
POSTGRES_PASSWORD=change-me
APP_SECRET=change-me
# Web: features still on fictitious data. Empty: the features whose API
# endpoints do not exist yet ("dashboard,domains,news"); the signed-in user is
# real. Also "all", "none" or a comma-separated list. Read at runtime:
# "docker compose up -d" applies a change, no rebuild needed.
API_MOCKS=
